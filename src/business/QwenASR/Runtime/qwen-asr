#!/bin/sh
set -eu
engine_root="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
export PYTHONHOME="$engine_root/asr-python"
export PYTHONPATH="$engine_root/asr-site"
export PYTHONDONTWRITEBYTECODE=1
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
exec "$engine_root/asr-python/bin/python3.12" "$engine_root/qwen_asr_worker.py" "$@"

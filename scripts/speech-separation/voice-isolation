#!/bin/sh
set -eu
engine_root="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
export PYTHONHOME="$engine_root/../qwen-asr-runtime/asr-python"
export PYTHONPATH="$engine_root/site"
export PYTHONDONTWRITEBYTECODE=1
export HF_HUB_OFFLINE=1
exec "$PYTHONHOME/bin/python3.12" "$engine_root/voice_worker.py" --assets "$engine_root" "$@"
